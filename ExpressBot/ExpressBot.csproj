<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ExpressBot</PackageId>
    <Version>0.1.0</Version>
    <Authors>vadarganiv</Authors>
    <Company>vadarganiv</Company>
    <PackageTags>Bot;Messenger;Express</PackageTags>
    <Description>Library for working with bots in eXpress enterprise messenger.</Description>
    <RepositoryUrl>https://github.com/vadarganiv/ExpressBot</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
